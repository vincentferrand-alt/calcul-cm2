rules_version = '2';
// Règles de sécurité de Calcul CM2 (à coller dans Firebase > Firestore > Règles).
// - Une seule collection "profils", un document par élève, nommé par une empreinte de 64 caractères (illisible, impossible à deviner).
// - Lecture d'un document précis seulement : on ne peut pas lister les profils, ni supprimer.
// - Écriture limitée à 2 champs de taille raisonnable (< 900 000 caractères).
service cloud.firestore {
  match /databases/{database}/documents {
    match /profils/{id} {
      allow get: if id.matches('^[0-9a-f]{64}$');
      allow create, update: if id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['data', 'maj'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.maj is string
        && request.resource.data.maj.size() < 40;
      allow list, delete: if false;
    }
  }
}
